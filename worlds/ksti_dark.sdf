<?xml version="1.0"?>
<!-- Dibangkitkan oleh tools/make_track.py; jangan edit tangan. -->
<sdf version="1.8">
  <world name="ksti">
    <physics name="2ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <scene>
      <ambient>0.9 0.9 0.9 1</ambient>
      <background>0.75 0.75 0.75 1</background>
      <grid>false</grid>
      <shadows>false</shadows>
    </scene>
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <direction>-0.2 0.1 -1</direction>
    </light>
    <model name="hall_floor">
      <static>true</static>
      <pose>0 0 -0.002 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material><ambient>0.12 0.12 0.13 1</ambient><diffuse>0.12 0.12 0.13 1</diffuse></material>
        </visual>
      </link>
    </model>
    <include><uri>model://ksti_track_dark</uri></include>
  </world>
</sdf>
