<?xml version="1.0"?>
<!--
  Mobil 1:10 kemudi Ackermann untuk Gazebo Fortress.
  Asal model = titik tanah di bawah poros roda belakang (sama dengan frame mobil di ksti_mav/core).
  Ukuran HARUS sama dengan PilotConfig (wheelbase, max_steer) dan CameraConfig (dijaga tests/test_core.py).
    wheelbase 0.26  track 0.16  kingpin 0.14  roda r 0.033  kamera x 0.22 z 0.24 pitch 0.55 hfov 1.60 640x480
-->
<sdf version="1.8">
  <model name="mav_car">
    <link name="base_link">
      <inertial>
        <pose>0.13 0 0.06 0 0 0</pose>
        <mass>1.8</mass>
        <inertia><ixx>0.0052</ixx><iyy>0.0244</iyy><izz>0.0289</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="chassis">
        <pose>0.13 0 0.075 0 0 0</pose>
        <geometry><box><size>0.40 0.18 0.04</size></box></geometry>
      </collision>
      <visual name="chassis">
        <pose>0.13 0 0.075 0 0 0</pose>
        <geometry><box><size>0.40 0.18 0.04</size></box></geometry>
        <material><ambient>0.1 0.3 0.8 1</ambient><diffuse>0.1 0.3 0.8 1</diffuse></material>
      </visual>
      <visual name="mast">
        <pose>0.22 0 0.16 0 0 0</pose>
        <geometry><box><size>0.02 0.02 0.14</size></box></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
      <sensor name="camera" type="camera">
        <pose>0.22 0 0.24 0 0.55 0</pose>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <topic>/camera/image_raw</topic>
        <camera>
          <horizontal_fov>1.60</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.02</near><far>30</far></clip>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.007</stddev></noise>
        </camera>
      </sensor>
    </link>

    <!-- roda belakang (penggerak) -->
    <link name="rear_left_wheel">
      <pose>0 0.08 0.033 0 0 0</pose>
      <inertial><mass>0.05</mass><inertia><ixx>1.6e-5</ixx><iyy>2.7e-5</iyy><izz>1.6e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="c"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.033</radius><length>0.025</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
      <visual name="v"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.033</radius><length>0.025</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual>
    </link>
    <link name="rear_right_wheel">
      <pose>0 -0.08 0.033 0 0 0</pose>
      <inertial><mass>0.05</mass><inertia><ixx>1.6e-5</ixx><iyy>2.7e-5</iyy><izz>1.6e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="c"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.033</radius><length>0.025</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
      <visual name="v"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.033</radius><length>0.025</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual>
    </link>

    <!-- poros kemudi depan (kingpin) + roda depan -->
    <link name="front_left_steer">
      <pose>0.26 0.07 0.033 0 0 0</pose>
      <inertial><mass>0.1</mass><inertia><ixx>2e-4</ixx><iyy>2e-4</iyy><izz>2e-4</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
    </link>
    <link name="front_right_steer">
      <pose>0.26 -0.07 0.033 0 0 0</pose>
      <inertial><mass>0.1</mass><inertia><ixx>2e-4</ixx><iyy>2e-4</iyy><izz>2e-4</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
    </link>
    <link name="front_left_wheel">
      <pose>0.26 0.08 0.033 0 0 0</pose>
      <inertial><mass>0.05</mass><inertia><ixx>1.6e-5</ixx><iyy>2.7e-5</iyy><izz>1.6e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="c"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.033</radius><length>0.025</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
      <visual name="v"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.033</radius><length>0.025</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual>
    </link>
    <link name="front_right_wheel">
      <pose>0.26 -0.08 0.033 0 0 0</pose>
      <inertial><mass>0.05</mass><inertia><ixx>1.6e-5</ixx><iyy>2.7e-5</iyy><izz>1.6e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="c"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.033</radius><length>0.025</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
      <visual name="v"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.033</radius><length>0.025</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual>
    </link>

    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>base_link</parent><child>rear_left_wheel</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>base_link</parent><child>rear_right_wheel</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="front_left_steer_joint" type="revolute">
      <parent>base_link</parent><child>front_left_steer</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-0.6</lower><upper>0.6</upper><effort>1e6</effort></limit></axis>
    </joint>
    <joint name="front_right_steer_joint" type="revolute">
      <parent>base_link</parent><child>front_right_steer</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-0.6</lower><upper>0.6</upper><effort>1e6</effort></limit></axis>
    </joint>
    <joint name="front_left_wheel_joint" type="revolute">
      <parent>front_left_steer</parent><child>front_left_wheel</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="front_right_wheel_joint" type="revolute">
      <parent>front_right_steer</parent><child>front_right_wheel</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <!-- Setir & roda dikendalikan per sendi; geometri Ackermann dihitung node sim_drive (lihat docstring-nya). -->
    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
      <joint_name>front_left_steer_joint</joint_name><topic>/sim/steer_left</topic>
      <p_gain>1.5</p_gain><i_gain>0</i_gain><d_gain>0.02</d_gain><cmd_max>5</cmd_max><cmd_min>-5</cmd_min>
    </plugin>
    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
      <joint_name>front_right_steer_joint</joint_name><topic>/sim/steer_right</topic>
      <p_gain>1.5</p_gain><i_gain>0</i_gain><d_gain>0.02</d_gain><cmd_max>5</cmd_max><cmd_min>-5</cmd_min>
    </plugin>
    <plugin filename="ignition-gazebo-joint-controller-system" name="ignition::gazebo::systems::JointController">
      <joint_name>rear_left_wheel_joint</joint_name><topic>/sim/wheel_left</topic>
    </plugin>
    <plugin filename="ignition-gazebo-joint-controller-system" name="ignition::gazebo::systems::JointController">
      <joint_name>rear_right_wheel_joint</joint_name><topic>/sim/wheel_right</topic>
    </plugin>
    <plugin filename="ignition-gazebo-odometry-publisher-system" name="ignition::gazebo::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_topic>/odom</odom_topic>
      <dimensions>2</dimensions>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
    <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher"/>
  </model>
</sdf>
